{
  "name": "orangehrm-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:headed": "playwright test --project=e2e --headed",
    "test:api": "playwright test --project=api --grep \"@api\"",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "test:qa": "cross-env ENV=qa playwright test",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
